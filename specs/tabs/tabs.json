    {
      "location": "tabs/1",
      "sid": "s-uqukzzk3j2w2gny",
      "kind": "section",
      "title": "The tabs",
      "status": "checked",
      "text": "What the tabs accept, and how they keep account of it.",
      "children": [
        {
          "location": "tabs/1.1",
          "sid": "s-t8zhcywbmp5rkbr",
          "kind": "rule",
          "title": "One tab for a regular",
          "status": "checked",
          "text": "The tabs refuse to open a tab for a regular they already keep a tab for.",
          "reason": "A tab's limit bounds what its regular owes, and with two tabs a regular could owe more than the limit of either. A tab is also identified by its regular's name, so of two tabs for one regular, which one a charge or a repayment goes to would be a guess.",
          "refs": [
            {
              "type": "constrains",
              "to": "s-6zwzkthktpq6c3c"
            },
            {
              "type": "implements",
              "from": "s-5mu2qm3u5ue82sk"
            }
          ],
          "meta": {
            "code": [
              {
                "file": "src/tabs/tabs.ts"
              }
            ],
            "tests": [
              "test/tabs.test.ts::@spec s-t8zhcywbmp5rkbr refuses to open a second tab for a regular, the first kept as it was"
            ]
          }
        },
        {
          "location": "tabs/1.2",
          "sid": "s-n7wmxj35vnsc9uk",
          "kind": "rule",
          "title": "A tab holds the debt within the limit",
          "status": "checked",
          "text": "The tabs refuse a charge that would take a regular's debt above the limit of their tab.",
          "reason": "The limit is what the saloon agreed to let a regular owe: a debt above it is credit nobody granted.",
          "refs": [
            {
              "type": "constrains",
              "to": "s-6zwzkthktpq6c3c"
            },
            {
              "type": "constrains",
              "to": "s-ehcz87hd3ygcjtp"
            },
            {
              "type": "implements",
              "from": "s-5mu2qm3u5ue82sk"
            },
            {
              "type": "implements",
              "from": "s-3srstg864vu2eyj"
            }
          ],
          "meta": {
            "code": [
              {
                "file": "src/tabs/tabs.ts"
              }
            ],
            "tests": [
              "test/tabs.test.ts::@spec s-n7wmxj35vnsc9uk refuses a charge that would take the debt above the limit, and takes one reaching it",
              "test/tabs.test.ts::@spec s-n7wmxj35vnsc9uk refuses every charge on a tab whose limit is nothing"
            ]
          }
        },
        {
          "location": "tabs/1.3",
          "sid": "s-t2a2p5jjest399m",
          "kind": "rule",
          "title": "A repayment never takes the debt below zero",
          "status": "checked",
          "text": "The tabs refuse a repayment larger than the regular's debt.",
          "reason": "A debt below zero would be money the saloon owes the regular, which a tab is not kept for.",
          "refs": [
            {
              "type": "constrains",
              "to": "s-gj3c6xu7mtvmgfm"
            },
            {
              "type": "implements",
              "from": "s-5mu2qm3u5ue82sk"
            }
          ],
          "meta": {
            "code": [
              {
                "file": "src/tabs/tabs.ts"
              }
            ],
            "tests": [
              "test/tabs.test.ts::@spec s-t2a2p5jjest399m refuses a repayment larger than the debt, and takes one equal to it"
            ]
          }
        },
        {
          "location": "tabs/1.4",
          "sid": "s-7vgppsr73pc8fgn",
          "kind": "rule",
          "title": "The tabs write everything they accept to the journal",
          "status": "checked",
          "text": "The tabs write every charge and every repayment they accept to the journal of the regular's tab, each as a journal entry.",
          "reason": "The debt is read off the journal (§s-r64zmxy6x6bvzyw), so a charge or a repayment left out of it would leave the debt wrong.",
          "refs": [
            {
              "type": "cites",
              "to": "s-r64zmxy6x6bvzyw"
            },
            {
              "type": "constrains",
              "to": "s-2896rux5emnnwpy"
            },
            {
              "type": "implements",
              "from": "s-5mu2qm3u5ue82sk"
            }
          ],
          "meta": {
            "code": [
              {
                "file": "src/tabs/tabs.ts"
              }
            ],
            "tests": [
              "test/tabs.test.ts::@spec s-7vgppsr73pc8fgn writes every charge and repayment the tabs accept to the regular's journal, and nothing they refuse"
            ]
          }
        },
        {
          "location": "tabs/1.5",
          "sid": "s-42z743tznzc48pm",
          "kind": "rule",
          "title": "The price of an order",
          "status": "checked",
          "text": "The tabs price an order as the sum, over its lines, of the supply's price times how many of it the line asks for.",
          "reason": "An order is charged for what it takes out of the stock, at the price the stock holds for each supply.",
          "refs": [
            {
              "type": "constrains",
              "to": "s-6dg6rvnzg7xmcm9"
            },
            {
              "type": "constrains",
              "to": "s-vugzkbduqu86uhr"
            },
            {
              "type": "constrains",
              "to": "s-f3kv8352za6w2un"
            },
            {
              "type": "implements",
              "from": "s-5mu2qm3u5ue82sk"
            }
          ],
          "meta": {
            "code": [
              {
                "file": "src/tabs/tabs.ts"
              }
            ],
            "tests": [
              "test/tabs.test.ts::@spec s-42z743tznzc48pm prices an order as the sum over its lines of the supply's price times how many the line asks for"
            ]
          }
        },
